<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_stock_tree_inherit" model="ir.ui.view">
            <field name="name">product.product.stock.tree.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock.product_product_stock_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='qty_available']" position="before">
                    <field name="lot_ids" string="Lotes" widget="many2many_tags" context="{'show_expiry': True}" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
    