<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_report_13_form" model="ir.ui.view">
        <field name="name">ple.report.13.form</field>
        <field name="model">ple.report.13</field>
        <field name="inherit_id" ref="dv_l10n_pe_sunat_moves_13.sunat_report_13_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='header_group']" position="before">
                <div class="alert alert-warning" role="alert" invisible="not l10n_pe_ple_warning">
                    <field name="l10n_pe_ple_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//group[@name='file_group']" position="inside">
                <field name="ple_txt_zip_filename" invisible="1"/>
                <field name="ple_txt_zip_binary" filename="ple_txt_zip_filename"/>
                <field name="ple_txt_01_filename" invisible="1"/>
                <field name="ple_txt_01_binary" filename="ple_txt_01_filename"/>
                <field name="ple_xls_01_filename" invisible="1"/>
                <field name="ple_xls_01_binary" filename="ple_xls_01_filename"/>
            </xpath>
        </field>
    </record>

    <record id="view_ple_report_13_tree" model="ir.ui.view">
        <field name="name">ple.report.13.tree</field>
        <field name="model">ple.report.13</field>
        <field name="inherit_id" ref="dv_l10n_pe_sunat_moves_13.sunat_report_13_view_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="ple_txt_01_filename" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_ple_report_13_search" model="ir.ui.view">
        <field name="name">ple.report.13.search</field>
        <field name="model">ple.report.13</field>
        <field name="inherit_id" ref="dv_l10n_pe_sunat_moves_13.sunat_report_13_view_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter name="generated" string="Generado" domain="[('state', '=', 'generated')]"/>
            </filter>
        </field>
    </record>

    <record id="action_ple_report_13" model="ir.actions.act_window">
        <field name="name">PLE 13.1 - Registro de Inventario Permanente Valorizado</field>
        <field name="res_model">ple.report.13</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_ple_report_13_tree"/>
        <field name="search_view_id" ref="view_ple_report_13_search"/>
    </record>
</odoo>
