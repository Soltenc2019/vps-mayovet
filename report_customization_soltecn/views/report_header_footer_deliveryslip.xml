<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="custom_header_footer_deliveryslip" inherit_id="Guia_Remision_Soltecn_2.custom_header_footer_deliveryslip">
            <xpath expr='//div' position="replace">
                <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                    <div class="o_boxed_header" style="font-size: 0.75rem !important;">
                        <div class="row pb-2">
                            <div t-att-class="'col-' + str(company.max_column_logo)" t-attf-style="display: -webkit-box; -webkit-box-pack: center; -webkit-box-orient: vertical;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" class="img-fluid" style="max-height: 130px;"/>
                            </div>
                            <div t-att-class="'col-' + str(8 - company.max_column_logo)+' ps-3'" t-attf-style="display: -webkit-box; -webkit-box-pack: center; -webkit-box-orient: vertical;">
                                <h4 t-if="company.report_header != '&lt;p&gt;&lt;br&gt;&lt;/p&gt;'" t-field="company.report_header"/>
                                <div name="company_address" class="text-center w-100">
                                    <span t-if="company.company_details" t-field="company.company_details"></span>
                                </div>
                            </div>
                            <div class="col-4" t-attf-style="display: -webkit-box; -webkit-box-pack: center; -webkit-box-orient: vertical;">
                                <div class="border border-dark rounded text-center p-2">
                                    <div>
                                        <span class="font-weight-bold fs-6">RUC <t t-out="o.company_id.vat"/></span>
                                    </div>
                                    <div>
                                        <span class="font-weight-bold fs-6 text-uppercase">GUÍA DE REMISIÓN REMITENTE ELECTRÓNICA</span>
                                    </div>
                                    <div>
                                        <span class="font-weight-bold fs-6" t-out="o.serial_referral_guide or 'NO VALID'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@t-attf-class='article o_report_layout_boxed o_company_#{company.id}_layout']" position="replace">
                <div t-attf-class="article o_report_layout_boxed o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                    <t t-foreach="company.space_body_header" t-as="item">
                        <br/>
                    </t>
                    <div t-att-class="'pt-' + str(company.padding_top_layout)">
                        <t t-call="web.address_layout"/>
                    </div>
                    <t t-out="0"/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>