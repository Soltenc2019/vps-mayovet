<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <div class="page" style="font-size: 0.75rem;">
                    <div id="invoice_header" class="row mb-2 mt-2">
                        <div t-attf-class="#{'col-12' if report_type != 'html' else 'col-12 col-sm-12'}">
                            <div class="border border-dark rounded mb-2">
                                <div class="p-2">                                    
                                    <div class="row mb-0">
                                        <div class="sm-auto col-8 col-sm-8 mb-0">
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-3 col-sm-3 mb-0">
                                                    CLIENTE:
                                                </dt>
                                                <dd class="sm-auto col-9 col-sm-9 mb-0">
                                                    <span class="text-wrap" t-field="o.partner_id.name"/>
                                                </dd>
                                            </dl>
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-3 col-sm-3 mb-0">
                                                    DIRECCIÓN:
                                                </dt>
                                                <dd class="sm-auto col-9 col-sm-9 mb-0">
                                                    <span class="text" t-esc="o.partner_id.street_name or ''"/> 
                                                    <span class="text" t-esc="o.partner_id.street_number or ''"/> 
                                                    <span class="text" t-esc="o.partner_id.street_number2 or ''"/> 
                                                    <t t-if="o.partner_id.l10n_pe_district">
                                                        , <span class="text" t-esc="o.partner_id.l10n_pe_district.name or ''"/>
                                                    </t>
                                                    <t t-if="o.partner_id.city_id">
                                                        , <span class="text-nowrap" t-esc="o.partner_id.city_id.name or ''"/>
                                                    </t>
                                                    <t t-if="o.partner_id.state_id">
                                                        , <span class="text-nowrap" t-esc="o.partner_id.state_id.name or ''"/>
                                                    </t>
                                                    <t t-if="o.partner_id.country_id">
                                                        , <span class="text-nowrap" t-esc="o.partner_id.country_id.name or ''"/>
                                                    </t>
                                                </dd>
                                            </dl>
                                            
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-3 col-sm-3 mb-0">
                                                    <span class="text-nowrap" t-esc="o.partner_id.l10n_latam_identification_type_id and o.partner_id.l10n_latam_identification_type_id.name or 'DOCUMENTO'"/>:
                                                </dt>
                                                <dd class="sm-auto col-9 col-sm-9 mb-0">
                                                    <span class="text-nowrap" t-esc="o.partner_id.vat or '00000000'"/>
                                                </dd>
                                            </dl>
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-3 col-sm-3 mb-0">
                                                    COND. DE PAGO:
                                                </dt>
                                                <dd class="sm-auto col-9 col-sm-9 mb-0">
                                                    <t t-if="o.invoice_payment_term_id.name">
                                                        <span class="text-nowrap" t-field="o.invoice_payment_term_id.name"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-if="o.invoice_date_due == o.invoice_date">
                                                            <span class="text-nowrap" t-esc="'Pago inmediato'"/>
                                                        </t>
                                                        <t t-else="">
                                                        -
                                                        </t>
                                                    </t>
                                                </dd>
                                            </dl>
                                        </div>
                                        <div class="sm-auto col-4 col-sm-4 mb-0">
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-6 col-sm-6 mb-0">
                                                    MONEDA:
                                                </dt>
                                                <dd class="sm-auto col-6 col-sm-6 mb-0">
                                                    <span class="text-nowrap" t-esc="o.currency_id.name == 'PEN' and 'Soles' or o.currency_id.currency_unit_label"/>
                                                </dd>
                                            </dl>
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-6 col-sm-6 mb-0">
                                                    FECHA EMISIÓN:
                                                </dt>
                                                <dd class="sm-auto col-6 col-sm-6 mb-0">
                                                    <span class="text-nowrap" t-field="o.invoice_date"/>
                                                </dd>
                                            </dl>
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-6 col-sm-6 mb-0">
                                                    FECHA DE VENC:
                                                </dt>
                                                <dd class="sm-auto col-6 col-sm-6 mb-0">
                                                    <span class="text-nowrap" t-field="o.invoice_date_due"/>
                                                </dd>
                                            </dl>
                                            <dl class="row mb-0">
                                                <dt class="sm-auto col-6 col-sm-6 mb-0">
                                                    CÓDIGO VEND:
                                                </dt>
                                                <dd class="sm-auto col-6 col-sm-6 mb-0">
                                                    <span class="text-nowrap" t-field="o.invoice_user_id.id"/>
                                                </dd>
                                            </dl>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                    
                    <table class="table table-sm o_main_table min-vh-50" name="invoice_line_table">
                        <thead>
                            <tr>
                                <th name="th_quantity" class="text-end"><span>CANT</span></th>
                                <th name="th_description" class="text-left"><span>DESCRIPCIÓN</span></th>
                                <th name="th_uom" class="text-end"><span>UDM</span></th>
                                <th name="th_valueunit" t-attf-class="text-end"><span>V/U</span></th>                               
                                <th name="th_priceunit" t-attf-class="text-end"><span>P/U</span></th>
                                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>DESC.%</span>
                                </th>
                                <th name="th_subtotal" class="text-end">
                                    <span>IMPORTE</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                            <t t-foreach="lines" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td name="account_invoice_line_name">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td t-attf-class="text-end">
                                            <span class="text-nowrap" t-esc="abs(line.price_subtotal/line.quantity)" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                        <td t-attf-class="text-end">
                                            <span class="text-nowrap" t-esc="abs(line.price_unit)"/>
                                        </td>
                                        <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.discount"/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <span class="text-nowrap" t-field="line.price_total"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div id="total" class="row">
                        <div t-attf-class="#{'col-8' if report_type != 'html' else 'col-12 col-sm-8'} mb-2" style="padding-right: 15px">
                            <div id="invoice_info" class="row">
                                <div class="col-auto mb-0">
                                    <div class="card mb-0">
                                        <div class="card-header">
                                            <dl class="row mb-0">
                                                <dt t-attf-class="#{'col-2' if report_type != 'html' else 'col-12 col-sm-2'} col-sm mb-0">
                                                    <strong>SON:</strong>
                                                </dt>
                                                <dd t-attf-class="#{'col-10' if report_type != 'html' else 'col-12 col-sm-10'} col-sm mb-0">
                                                    <span class="text-wrap" t-field="o.l10n_pe_edi_amount_in_words"/>
                                                    <!-- <span class="text-wrap"><t t-esc="extra_edi_vals.get('amount_to_text')"/></span> -->
                                                </dd>
                                            </dl>
                                        </div>
                                        <div class="card-body">
                                            <div id="invoice_footer" class="row">
                                                <div t-attf-class="#{'col-9' if report_type != 'html' else 'col-12 col-sm-9'} col-auto mb-2">
                                                    <div class="mb-1">Representación impresa de la <span class="font-weight-bold text-uppercase" t-esc="o.l10n_latam_document_type_id and o.l10n_latam_document_type_id.report_name or ''"/> <span class="font-weight-bold" t-esc="o.name or ''"/>
                                                    </div>
                                                    <t t-if="o.move_type in ('out_refund','in_refund')">
                                                        <div t-if="o.reversed_entry_id" class="row mb-0">
                                                            <dt t-attf-class="col-5 col-sm mb-0">Número de Factura</dt>
                                                            <div t-attf-class="col-7 col-sm mb-0">
                                                                : <span class="text-wrap" t-field="o.reversed_entry_id.name"/>
                                                            </div>
                                                        </div>
                                                        <div t-if="o.reversed_entry_id" class="row mb-0">
                                                            <dt t-attf-class="col-5 col-sm mb-0">Motivo</dt>
                                                            <div t-attf-class="col-7 col-sm mb-0">
                                                                : <span class="text-wrap" t-field="o.l10n_pe_edi_refund_reason"/> <span t-esc="(' ('+ o.ref.split(', ')[1]+' )') if len(o.ref.split(', ')) == 2 else ''"/>
                                                            </div>
                                                        </div>
                                                    </t>
                                                    <div class="mb-1">Este documento puede ser validado usando su clave SOL</div>
                                                    <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                                                        <div class="mb-1"><t t-esc="bank.bank_id.name"/>: <t t-esc="bank.acc_number"/></div>
                                                    </t>
                                                    <dl class="row mb-0" t-if="o.journal_id.custom_message">
                                                        <dd class="col-auto col-7 mb-0" t-esc="o.journal_id.custom_message"/>
                                                    </dl>
                                                    <dl class="row mb-0" t-if="o.l10n_pe_edi_legend_value">
                                                        <dd class="col-auto col-7 mb-0" t-esc="o.l10n_pe_edi_legend_value"/>
                                                    </dl>
                                                    <dl class="row mb-0" t-if="o.narration">
                                                        <dt class="col-auto col-5 mr-0 mb-0">
                                                            Términos y condiciones:
                                                        </dt>
                                                        <dd class="col-auto col-7 mb-0" t-esc="o.narration"/>
                                                    </dl>
                                                </div>
                                                <div t-attf-class="#{'col-3' if report_type != 'html' else 'col-12 col-sm-3'} col-auto mb-2">
                                                        <img t-att-src="'/report/barcode/QR/%s|%s|%s|%s|%s|%s|%s|%s|%s|'%(o.company_id.vat,o.l10n_latam_document_type_id.code,o.sequence_prefix[:-1],o.sequence_number,o.amount_tax,o.amount_total,o.invoice_date,o.partner_id.l10n_latam_identification_type_id.l10n_pe_vat_code,o.partner_id.vat)" class="img-fluid img-thumbnail rounded mx-auto d-block" style="width:100px;height:100px;"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <t t-set="dues" t-value="o.line_ids.filtered(lambda l: l.account_type=='asset_receivable')"/>
                            <t t-set="is_detraction" t-value="o.l10n_pe_edi_operation_type in ('1001', '1002', '1003', '1004')"/>
                            <!-- <t t-set="amount_detraction" t-value="o.l10n_pe_edi_total_detraction"/> -->
                            <t t-set="first_time" t-value="True"/>
                            <t t-set="is_retention" t-value="o.l10n_pe_edi_retention_type_id"/>
                            <t t-set="PaymentMeansID" t-value="o._l10n_pe_edi_get_payment_means()"/>
                            <t t-if="dues and not PaymentMeansID == 'Contado'">
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-auto mb-0">
                                            <table class="table table-sm" style="page-break-inside: avoid;">
                                                <thead>
                                                    <tr><th colspan="3" class="text-center"><strong>CUOTAS</strong></th></tr>
                                                    <tr>
                                                        <th name="th_dues_number" class="text-end">NRO</th>
                                                        <th name="th_dues_paid_date" class="text-end">FECHA PAGO</th>
                                                        <th name="th_dues_amount" class="text-end">MONTO</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-set="amount_total" t-value="0"/>
                                                    <t t-set="retention_detraction_discount" t-value="0"/>
                                                    <t t-foreach="dues" t-as="due">
                                                        <t t-if="first_time and is_detraction">
                                                            <!-- <t t-set="retention_detraction_discount" t-value="spot.get('spot_amount')"/> -->
                                                            <t t-set="retention_detraction_discount" t-value="o.l10n_pe_edi_total_detraction"/>
                                                        </t>
                                                        <t t-if="first_time and is_retention">
                                                            <t t-set="retention_detraction_discount" t-value="o.l10n_pe_edi_total_retention"/>
                                                        </t>
                                                        <t t-set="first_time" t-value="False"/>
                                                        <t t-set="amount_total" t-value="amount_total + due.amount_currency - retention_detraction_discount"/>
                                                        <tr>
                                                            <td class="text-end">
                                                                <span t-esc="due_index + 1"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-field="due.date_maturity"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-esc="due.amount_currency - retention_detraction_discount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                            </td>
                                                        </tr>
                                                        <t t-set="retention_detraction_discount" t-value="0"/>
                                                    </t>
                                                    <tr class="o_total">
                                                        <td class="text-end" colspan="2">
                                                            TOTAL
                                                        </td>
                                                        <td class="text-end">
                                                            <span t-esc="amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </dt>
                                    </dl>
                                </div>
                            </t>
                        </div>
                        <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-12 col-sm-4'} mb-2">
                            <table class="table table-sm" style="page-break-inside: avoid;">
                                <t t-set="base_amount" t-value="0"/>
                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                                <t t-foreach="lines" t-as="line">
                                    <t t-if="line.l10n_pe_edi_affectation_reason == '10'  " t-set="base_amount" t-value="base_amount + line.price_subtotal"/>
                                </t>
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="invoice_sunat_soltecn_v16.document_tax_totals_2"/>
                            </table>
                            <table class="table table-sm" style="page-break-inside: avoid;" t-if="o.l10n_pe_edi_retention_type_id">
                                <tr class="o_subtotal" t-if="o.l10n_pe_edi_total_retention">
                                    <td>
                                        <strong><span>Retención</span> <span t-esc="o.l10n_pe_edi_retention_type_id.rate"/>%</strong>
                                    </td>
                                    <td class="text-end o_price_total">
                                        <span class="text-nowrap" t-field="o.l10n_pe_edi_total_retention"/>
                                    </td>
                                </tr>
                                <tr class="border-black o_total" t-if="o.l10n_pe_edi_amount_total_retention">
                                    <td><strong>Total con retención</strong></td>
                                    <td class="text-end">
                                        <span class="text-nowrap" t-field="o.l10n_pe_edi_amount_total_retention"/>
                                    </td>
                                </tr>
                            </table>
                            <table class="table table-sm" style="page-break-inside: avoid;" t-if="o.l10n_pe_edi_operation_type in ('1001','1002','1003','1004')">
                                <tr class="o_subtotal" t-if="o.l10n_pe_edi_total_detraction">
                                    <td>
                                        <strong><span>Detracción</span> <span t-esc="o.l10n_pe_edi_porcentage_detraction"/>%</strong>
                                    </td>
                                    <td class="text-end o_price_total">
                                        <!-- <t t-if="o.currency_id.name == 'PEN'">
                                            <span class="text-nowrap" t-field="o.l10n_pe_edi_total_detraction_signed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </t>
                                        <t t-else=""> -->
                                        <span class="text-nowrap" t-field="o.l10n_pe_edi_total_detraction" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        <!-- </t> -->
                                    </td>
                                </tr>
                                <tr class="border-black o_total" t-if="o.l10n_pe_edi_amount_total_detraction">
                                    <td><strong>Total con detracción</strong></td>
                                    <td class="text-end">
                                        <span class="text-nowrap" t-field="o.l10n_pe_edi_amount_total_detraction" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div t-if="o.l10n_pe_edi_operation_type in ('1001','1002','1003','1004')" id="invoice_info" class="row">
                        <div class="col-auto mb-0">
                            <div class="card mb-0">
                                <div class="card-header">
                                    <dl class="row mb-0">
                                        <dd t-attf-class="row col-12 mb-0">
                                            <span class="text-nowrap">Detracción en monedas soles</span>
                                        </dd>
                                    </dl>
                                </div>
                                <div class="card-body">
                                    <div id="invoice_footer" class="row">
                                        <t t-set="lines_p" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                                        <t t-set="porcentage" t-value="max(lines_p.mapped('product_id.l10n_pe_withhold_percentage'))"/>
                                        <dl class="row col-6 mb-0">
                                            <dt t-attf-class="col-4 mb-0">
                                                <strong>% Detracción:</strong>
                                            </dt>
                                            <dd t-attf-class="col-8 mb-0">
                                                <t t-esc="porcentage"/>
                                            </dd>
                                        </dl>                                            
                                        <dl class="row col-6 mb-0">
                                            <dt t-attf-class="col-5 mb-0">
                                                <strong>Monto Detracción:</strong>
                                            </dt>
                                            <dd t-attf-class="col-7 mb-0">
                                                <span t-field="o.l10n_pe_edi_total_detraction_signed" t-options='{"widget": "monetary"}'/>
                                            </dd>
                                        </dl>
                                    </div>
                                    <div id="invoice_footer" class="row">
                                        <dl class="row col-12 mb-0">
                                            <dt t-attf-class="col-2 mb-0">
                                                <strong>Descripción:</strong>
                                            </dt>
                                            <t t-set="national_bank" t-value="o.env.ref('l10n_pe.peruvian_national_bank')"/><!--CHANGE l10n_pe_edi ->  l10n_pe-->
                                            <t t-set="national_bank_account" t-value="o.company_id.bank_ids.filtered(lambda b: b.bank_id == national_bank)"/>
                                            <dd t-attf-class="col-10 mb-0">
                                                <span>OPERACION SUJETA AL SISTEMA DE PAGO DE OBLIGACIONES TRIBUTARIAS DEL BANCO DE LA NACION <t t-esc="national_bank_account[0].acc_number"/></span>
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="document_tax_totals_2">
            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                <tr class="border-black o_subtotal">
                    <td><strong t-esc="'OP. GRAVADA'"/></td>
                    <!-- subtotal['name'] -->

                    <td class="text-end">
                        <span class="text-nowrap"
                            t-esc="base_amount"
                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        <!--<span-->
                        <!--    t-att-class="oe_subtotal_footer_separator"-->
                        <!--    t-esc="subtotal['formatted_amount']"-->
                        <!--/>-->
                    </td>
                </tr>

                <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                <t t-call="invoice_sunat_soltecn_v16.tax_groups_totals_2"/>
            </t>

            <!--Total amount with all taxes-->
            <tr class="border-black o_total">
                <td><strong>TOTAL</strong></td>
                <td class="text-end">
                    <span t-esc="tax_totals['formatted_amount_total']"/>
                </td>
            </tr>
        </template>

        <template id="tax_groups_totals_2">
            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]" t-as="amount_by_group">
                <tr>
                    <!-- <t t-if="len(tax_totals['groups_by_subtotal'][subtotal_to_show]) > 1 or (tax_totals['amount_untaxed'] != amount_by_group['tax_group_base_amount'])">
                        <td>
                            <span t-esc="amount_by_group['tax_group_name']"/>
                            <span class="text-nowrap"> on
                                <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                            </span>
                        </td>
