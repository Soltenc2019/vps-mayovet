    <!-- Menu -->
	<menuitem name="Factura Electronica" id="l10n_pe_edi_configuration_menu" parent="account.menu_finance_configuration" sequence="23">
		<menuitem name="Catalog 23 - Codigos- Regimenes de Retencion" id="l10n_pe_edi_catalog_23_menu" action="catalog_23_action" sequence="23"/>
