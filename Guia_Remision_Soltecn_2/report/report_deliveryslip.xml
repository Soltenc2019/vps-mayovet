                        <t t-set="aero_port" t-value="o.aeroport_locations"/>
                        <t t-set="aero_port_name" t-value="'AEROPUERTO'"/>
                    </t>
                    <div class="page container" style="font-size: 0.6rem !important;text-transform: uppercase;">
                        <div class="row border border-dark border-bottom-0">
                            <div class="col-6 pt-1 ps-1 pb-1 border-end border-dark">
                                <div></div>
                                <t t-if="o.transportation_reason == '08'">
                                <div><strong><t t-esc="aero_port_name"/> DE PARTIDA</strong></div>
                                </t>
                                <t t-else="">
                                <div><strong>PUNTO DE PARTIDA</strong></div>
                                </t>
                                <!-- <div>LIMA - LIMA - LIMA</div> -->
                                <div class="d-flex flex-row">
                                    <div style="width: 100%;">
                                        <t t-if="o.transportation_reason == '08'">
                                        <t t-esc="aero_port.address"/>
                                        <t t-if="aero_port.district">
                                            , <span class="text" t-esc="aero_port.district"/>
                                        </t>
                                        <t t-if="aero_port.province">
                                            , <span class="text-nowrap" t-esc="aero_port.province"/>
                                        </t>
                                        <t t-if="aero_port.department">
                                            , <span class="text-nowrap" t-esc="aero_port.department"/>
                                        </t>
                                        </t>
                                        <t t-else="">
                                        <t t-esc="o.starting_address.contact_address"/>
                                        <t t-if="o.starting_address.l10n_pe_district">
                                            , <span class="text" t-esc="o.starting_address.l10n_pe_district.name or ''"/>
                                        </t>
                                        <t t-if="o.starting_address.city_id">
                                            , <span class="text-nowrap" t-esc="o.starting_address.city_id.name or ''"/>
                                        </t>
                                        <t t-if="o.starting_address.state_id">
                                            , <span class="text-nowrap" t-esc="o.starting_address.state_id.name or ''"/>
                                        </t>
                                        </t>
                                    </div>
                                    <!-- <div style="width: 10%;">
                                        140101
                                    </div>   -->
                                </div>
                            </div>
                            <div class="col-6 pt-1 ps-1 pb-1">
                                <t t-if="o.transportation_reason == '09'">
                                <div><strong><t t-esc="aero_port_name"/> DE LLEGADA</strong></div>
                                </t>
                                <t t-else="">
                                <div><strong>PUNTO DE LLEGADA</strong></div>
                                </t>
