<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="stock_report_delivery_aggregated_move_lines_with_lots">
            <t t-foreach="aggregated_lines" t-as="line">
                <div class="col-12">
                    <div class="row border border-bottom-0 border-dark">
                        <div class="col-1 border-end border-dark pt-1 ps-1 pb-1 text-center">
                            <span t-esc="index_lines_table + 1"/>
                        </div>
                        <div t-att-class="'col-4 border-end border-dark pt-1 ps-1 pb-1' if o.specify_weight_by_bultos_paletas else 'col-6 border-end border-dark pt-1 ps-1 pb-1'">                  
                            <!-- <t t-if="aggregated_lines[line]['default_code']">[<span t-esc="aggregated_lines[line]['default_code']"/>]</t><span t-esc="aggregated_lines[line]['product_name_only']"/> / SERIE: <span t-esc="aggregated_lines[line]['lots'][:-2]"/> -->
                            <span t-esc="aggregated_lines[line]['name']"/> / SERIE: <span t-esc="aggregated_lines[line]['lots'][:-2]"/>
                        </div>
                        <div class="col-3 border-end border-dark pt-1 ps-1 pb-1 text-center">                             
                            <span t-esc="aggregated_lines[line]['product_uom']"/>
                        </div>
                        <div t-att-class="'col-2 pt-1 ps-1 pb-1 text-right' if not o.specify_weight_by_bultos_paletas else 'col-2 border-end border-dark  pt-1 ps-1 pb-1 text-right'">                            
                            <span t-esc="aggregated_lines[line]['quantity']"
                                t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
                        </div>
                        <div t-if="o.specify_weight_by_bultos_paletas" class="col-2 pt-1 ps-1 pb-1 text-right">
                            <span t-esc="aggregated_lines[line]['weight_total']"/>
                        </div>
                    </div>
                </div>
            </t>
        </template>
        <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
