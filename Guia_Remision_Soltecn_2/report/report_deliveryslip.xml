                        <!-- NEW -->
                        <div class="row border border-dark mx-n3">
                            <div class="col-6 border-end border-dark pt-1 ps-1 pb-1">
                                <div t-if="o.origin_invoice">
                                    <strong>COMPROBANTE ELECTRONICO:</strong> <t t-esc="o.origin_invoice.name"/>
