<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_move_form_soltecn" model="ir.ui.view">
            <field name="name">account.move.form.soltecn</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_left_group']" position="inside">
                    <field name="available_guide_reference" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" widget="many2many_tags" domain="[('origin_invoice','=',id),('serial_referral_guide', '!=', False)]"/>
                </xpath>               
            </field>
        </record>
</odoo>