<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.gre</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']//block[@name='operations_setting_container']" position="after">
                <block title="SUNAT" name="sunat_gre_setting_container">
                    <setting id="conf_specify_weight"
                             string="Especificar peso automáticamente"
                             help="Verdadero: el peso de los productos transportados se calcula según el peso especificado en los productos. Falso: el peso se especifica manualmente.">
                        <field name="specify_weight"/>
                    </setting>
                    <setting id="conf_specify_weight_by_bultos_paletas"
                             string="Especificar peso en bultos o paletas"
                             help="Mostrar el peso de los bultos en el reporte de guía de remisión.">
                        <field name="specify_weight_by_bultos_paletas"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
