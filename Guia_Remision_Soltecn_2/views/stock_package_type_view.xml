<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_package_type_form" model="ir.ui.view">
            <field name="model">stock.package.type</field>
            <field name="inherit_id" ref="stock.stock_package_type_form"/>
            <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <!-- <field name="measure_unit_code" /> -->
                <field name="package_type_uom" />
                <field name="package_type_weight" />
                <field name="package_type_default" />
            </xpath>            
            </field>
        </record>
    </data>
</odoo>