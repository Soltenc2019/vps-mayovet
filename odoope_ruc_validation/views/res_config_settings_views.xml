<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.einvoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="RUC/DNI Validation" name="ruc_validation_setting_container">
                    <setting id="ruc_validation"
                             string="RUC validation"
                             company_dependent="1"
                             help="Extract your client's data from SUNAT">
                        <field name="l10n_pe_ruc_validation"/>
                    </setting>
                    <setting id="dni_validation"
                             string="DNI validation"
                             company_dependent="1"
                             help="Validate the names and surnames of your contacts with DNI">
                        <field name="l10n_pe_dni_validation"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
